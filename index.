  <!-- JAVASCRIPT LOGIC (IMMUTABLE STORAGE + SHARING) -->
  <script>
    (function() {
      'use strict';

      // Storage Key for LocalStorage
      var STORAGE_KEY = 't1d_blood_sugar_diary_entries_v1';

      // Elements
      var form = document.getElementById('diabetesForm');
      var logDateInput = document.getElementById('logDate');
      var btnSetToday = document.getElementById('btnSetToday');
      var tableBody = document.getElementById('tableBody');
      var emptyMessage = document.getElementById('emptyMessage');
      var tableSearch = document.getElementById('tableSearch');

      var statTotalDays = document.getElementById('statTotalDays');
      var statAvgFasting = document.getElementById('statAvgFasting');
      var statAvgPostMeal = document.getElementById('statAvgPostMeal');
      var statTotalInsulin = document.getElementById('statTotalInsulin');

      var btnShareWhatsApp = document.getElementById('btnShareWhatsApp');
      var btnCopySummary = document.getElementById('btnCopySummary');
      var btnDownloadCSV = document.getElementById('btnDownloadCSV');
      var btnPrintReport = document.getElementById('btnPrintReport');
      var btnExportSummaryModal = document.getElementById('btnExportSummaryModal');

      var summaryModal = document.getElementById('summaryModal');
      var btnCloseModal = document.getElementById('btnCloseModal');
      var summaryTextContent = document.getElementById('summaryTextContent');
      var btnModalCopy = document.getElementById('btnModalCopy');
      var btnModalWhatsApp = document.getElementById('btnModalWhatsApp');
      var toast = document.getElementById('toast');

      // Helper: Show Toast
      function showToast(msg) {
        if (!toast) return;
        toast.textContent = msg;
        toast.className = 'show';
        setTimeout(function() {
          toast.className = toast.className.replace('show', '');
        }, 3200);
      }

      // Helper: Format Date YYYY-MM-DD
      function getTodayString() {
        var now = new Date();
        var y = now.getFullYear();
        var m = String(now.getMonth() + 1).padStart(2, '0');
        var d = String(now.getDate()).padStart(2, '0');
        return y + '-' + m + '-' + d;
      }

      function formatDateDisplay(dateStr) {
        if (!dateStr) return '';
        var parts = dateStr.split('-');
        if (parts.length === 3) {
          return parts[2] + '/' + parts[1] + '/' + parts[0];
        }
        return dateStr;
      }

      // Set today's date on load
      logDateInput.value = getTodayString();
      btnSetToday.addEventListener('click', function() {
        logDateInput.value = getTodayString();
      });

      // Load entries from localStorage
      // STRICT IMMUTABILITY: We provide ONLY Read & Append operations.
      // There are deliberately NO delete, edit, or clear functions exposed to the UI!
      function loadEntries() {
        try {
          var raw = localStorage.getItem(STORAGE_KEY);
          if (!raw) return [];
          var list = JSON.parse(raw);
          if (!Array.isArray(list)) return [];
          return list;
        } catch (e) {
          console.error("Storage read error", e);
          return [];
        }
      }

      function saveEntryPermanently(entry) {
        var entries = loadEntries();
        // Append strictly without overwriting or deleting
        entries.push(entry);
        localStorage.setItem(STORAGE_KEY, JSON.stringify(entries));
      }

      // Sugar styling badge
      function renderSugarBadge(value) {
        if (value === null || value === undefined || value === '') return '<span style="color:#94A3B8;">-</span>';
        var num = parseFloat(value);
        if (isNaN(num)) return value;
        var cls = 'sugar-normal';
        if (num < 70) cls = 'sugar-low';
        else if (num > 180) cls = 'sugar-high';
        return '<span class="sugar-pill ' + cls + '">' + num + '</span>';
      }

      function renderVal(val) {
        if (val === null || val === undefined || val === '') return '<span style="color:#94A3B8;">-</span>';
        return String(val);
      }

      function renderInsulin(val) {
        if (val === null || val === undefined || val === '') return '<span style="color:#94A3B8;">-</span>';
        return '<span class="insulin-tag">' + val + ' U</span>';
      }

      // Render the History Table and update statistics
      function renderUI() {
        var entries = loadEntries();
        var query = (tableSearch.value || '').trim().toLowerCase();

        // Sort descending by date & created timestamp (latest on top)
        var sorted = entries.slice().reverse();

        if (query) {
          sorted = sorted.filter(function(item) {
            var fullSearchStr = (
              item.date + ' ' + 
              (item.breakfast.nashta || '') + ' ' +
              (item.lunch.meal || '') + ' ' +
              (item.dinner.meal || '') + ' ' +
              (item.remarks || '')
            ).toLowerCase();
            return fullSearchStr.indexOf(query) !== -1;
          });
        }

        // Empty state check
        if (sorted.length === 0) {
          tableBody.innerHTML = '';
          emptyMessage.style.display = 'block';
        } else {
          emptyMessage.style.display = 'none';
          var html = '';
          for (var i = 0; i < sorted.length; i++) {
            var item = sorted[i];
            var bf = item.breakfast || {};
            var ln = item.lunch || {};
            var dn = item.dinner || {};

            html += '<tr>' +
              '<td class="td-center" style="font-weight:700; white-space:nowrap;">' + formatDateDisplay(item.date) + '</td>' +
              
              // Breakfast
              '<td class="td-center">' + renderSugarBadge(bf.sugar) + '</td>' +
              '<td class="td-center">' + renderInsulin(bf.insulin) + '</td>' +
              '<td>' + renderVal(bf.nashta) + '</td>' +
              '<td class="td-center">' + renderSugarBadge(bf.sugar2h) + '</td>' +
              '<td>' + renderVal(bf.elevenAm) + '</td>' +

              // Lunch
              '<td class="td-center">' + renderSugarBadge(ln.sugar) + '</td>' +
              '<td class="td-center">' + renderInsulin(ln.insulin) + '</td>' +
              '<td>' + renderVal(ln.meal) + '</td>' +
              '<td class="td-center">' + renderSugarBadge(ln.sugar2h) + '</td>' +
              '<td>' + renderVal(ln.fivePm) + '</td>' +

              // Dinner
              '<td class="td-center">' + renderSugarBadge(dn.sugar) + '</td>' +
              '<td class="td-center">' + renderInsulin(dn.insulin) + '</td>' +
              '<td>' + renderVal(dn.meal) + '</td>' +
              '<td class="td-center">' + renderSugarBadge(dn.sugar2h) + '</td>' +
              '<td class="td-center">' + renderInsulin(dn.tresiba) + '</td>' +
              '<td class="td-center">' + renderVal(dn.milk) + '</td>' +

              // Remarks
              '<td>' + renderVal(item.remarks) + '</td>' +
            '</tr>';
          }
          tableBody.innerHTML = html;
        }

        // Calculate Stats
        statTotalDays.textContent = entries.length;

        var fastingSum = 0;
        var fastingCount = 0;
        var postMealSum = 0;
        var postMealCount = 0;
        var lastTotalInsulin = 0;

        for (var k = 0; k < entries.length; k++) {
          var e = entries[k];
          if (e.breakfast && e.breakfast.sugar) {
            var fs = parseFloat(e.breakfast.sugar);
            if (!isNaN(fs)) {
              fastingSum += fs;
              fastingCount++;
            }
          }
          var p2hArr = [
            e.breakfast ? parseFloat(e.breakfast.sugar2h) : NaN,
            e.lunch ? parseFloat(e.lunch.sugar2h) : NaN,
            e.dinner ? parseFloat(e.dinner.sugar2h) : NaN
          ];
          for (var p = 0; p < p2hArr.length; p++) {
            if (!isNaN(p2hArr[p])) {
              postMealSum += p2hArr[p];
              postMealCount++;
            }
          }
        }

        statAvgFasting.textContent = fastingCount > 0 ? Math.round(fastingSum / fastingCount) : '-';
        statAvgPostMeal.textContent = postMealCount > 0 ? Math.round(postMealSum / postMealCount) : '-';

        if (entries.length > 0) {
          var last = entries[entries.length - 1];
          var totalU = 0;
          if (last.breakfast && last.breakfast.insulin) totalU += (parseFloat(last.breakfast.insulin) || 0);
          if (last.lunch && last.lunch.insulin) totalU += (parseFloat(last.lunch.insulin) || 0);
          if (last.dinner && last.dinner.insulin) totalU += (parseFloat(last.dinner.insulin) || 0);
          if (last.dinner && last.dinner.tresiba) totalU += (parseFloat(last.dinner.tresiba) || 0);
          statTotalInsulin.textContent = totalU > 0 ? totalU + ' U' : '-';
        } else {
          statTotalInsulin.textContent = '-';
        }
      }

