      // Generate Clean Text Summary for Doctor/Sharing
      function generateTextSummary(entriesToFormat) {
        var list = entriesToFormat || loadEntries();
        if (!list || list.length === 0) {
          return "दैनिक ब्लड शुगर एवं आहार डायरी (Type 1 Diabetes Log)\nकोई रिकॉर्ड उपलब्ध नहीं है।";
        }

        var lines = [];
        lines.push("📋 दैनिक ब्लड शुगर एवं आहार डायरी (Type 1 Diabetes Daily Log)");
        lines.push("🔒 सुरक्षित अपरिवर्तनीय चिकित्सा रिकॉर्ड (Tamper-Proof Log)");
        lines.push("━━━━━━━━━━━━━━━━━━━━━━━━━━━━");

        // Format latest up to last 7 days or single day
        var items = list.slice(-5); // latest 5 entries
        for (var i = 0; i < items.length; i++) {
          var item = items[i];
          var bf = item.breakfast || {};
          var ln = item.lunch || {};
          var dn = item.dinner || {};

          lines.push("\n📅 तारीख: " + formatDateDisplay(item.date));
          
          lines.push("🌅 नाश्ता / Fasting:");
          lines.push("  • फास्टिंग शुगर: " + (bf.sugar ? bf.sugar + " mg/dL" : "-"));
          lines.push("  • नोवोरेपिड इंसुलिन: " + (bf.insulin ? bf.insulin + " U" : "-"));
          lines.push("  • नाश्ता: " + (bf.nashta || "-"));
          lines.push("  • 2 घंटे बाद शुगर: " + (bf.sugar2h ? bf.sugar2h + " mg/dL" : "-"));
          lines.push("  • 11 AM नोट: " + (bf.elevenAm || "-"));

          lines.push("☀️ दोपहर का भोजन (Lunch):");
          lines.push("  • लंच पूर्व शुगर: " + (ln.sugar ? ln.sugar + " mg/dL" : "-"));
          lines.push("  • नोवोरेपिड इंसुलिन: " + (ln.insulin ? ln.insulin + " U" : "-"));
          lines.push("  • लंच: " + (ln.meal || "-"));
          lines.push("  • 2 घंटे बाद शुगर: " + (ln.sugar2h ? ln.sugar2h + " mg/dL" : "-"));
          lines.push("  • 5 PM नोट: " + (ln.fivePm || "-"));

          lines.push("🌙 रात का भोजन (Dinner):");
          lines.push("  • डिनर पूर्व शुगर: " + (dn.sugar ? dn.sugar + " mg/dL" : "-"));
          lines.push("  • नोवोरेपिड इंसुलिन: " + (dn.insulin ? dn.insulin + " U" : "-"));
          lines.push("  • डिनर: " + (dn.meal || "-"));
          lines.push("  • 2 घंटे बाद शुगर: " + (dn.sugar2h ? dn.sugar2h + " mg/dL" : "-"));
          lines.push("  • ट्रेसीबा (बेसल): " + (dn.tresiba ? dn.tresiba + " U" : "-"));
          lines.push("  • दूध: " + (dn.milk || "-"));

          if (item.remarks) {
            lines.push("📝 टिप्पणी/एक्टिविटी: " + item.remarks);
          }
          lines.push("────────────────────────────");
        }

        lines.push("\n*यह रिकॉर्ड टाइप 1 डायबिटीज प्रबंधन हेतु स्थानीय रूप से सुरक्षित रखा गया है।");
        return lines.join("\n");
      }

      // Native Bridge or Web Share / Clipboard
      function shareViaWhatsApp() {
        var text = generateTextSummary();
        if (window.AndroidBridge && window.AndroidBridge.shareOnWhatsApp) {
          window.AndroidBridge.shareOnWhatsApp(text);
          return;
        }
        var encoded = encodeURIComponent(text);
        var url = "https://api.whatsapp.com/send?text=" + encoded;
        window.open(url, '_blank');
      }

      function shareGeneral() {
        var text = generateTextSummary();
        if (window.AndroidBridge && window.AndroidBridge.shareText) {
          window.AndroidBridge.shareText(text);
          return;
        }
        if (navigator.share) {
          navigator.share({
            title: 'दैनिक ब्लड शुगर एवं आहार डायरी',
            text: text
          }).catch(function(err) {
            console.log("Share skipped", err);
          });
        } else {
          copyToClipboard(text);
        }
      }

      function copyToClipboard(text) {
        if (window.AndroidBridge && window.AndroidBridge.copyToClipboard) {
          window.AndroidBridge.copyToClipboard(text);
          showToast('📋 क्लिपबोर्ड पर कॉपी किया गया!');
          return;
        }
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(function() {
            showToast('📋 डॉक्टर सारांश क्लिपबोर्ड पर कॉपी हुआ!');
          }).catch(function() {
            fallbackCopy(text);
          });
        } else {
          fallbackCopy(text);
        }
      }

      function fallbackCopy(text) {
        var ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.left = '-9999px';
        document.body.appendChild(ta);
        ta.select();
        try {
          document.execCommand('copy');
          showToast('📋 क्लिपबोर्ड पर कॉपी हुआ!');
        } catch (e) {
          showToast('कॉपी करने में असमर्थ, कृपया मैन्युअल चयन करें');
        }
        document.body.removeChild(ta);
      }

      // Download CSV
      function downloadCSV() {
        var entries = loadEntries();
        if (entries.length === 0) {
          showToast('कोई डेटा उपलब्ध नहीं है!');
          return;
        }

        var headers = [
          "Date",
          "Fasting_Sugar_mgdl", "Breakfast_Novorapid_Units", "Nashta_Meal", "Breakfast_2H_Sugar", "MidMorning_11Am",
          "Pre_Lunch_Sugar", "Lunch_Novorapid_Units", "Lunch_Meal", "Lunch_2H_Sugar", "Evening_5Pm_Note",
          "Pre_Dinner_Sugar", "Dinner_Novorapid_Units", "Dinner_Meal", "Dinner_2H_Sugar", "Tresiba_Units", "Milk",
          "Remarks"
        ];

        var rows = [headers.join(",")];

        for (var i = 0; i < entries.length; i++) {
          var item = entries[i];
          var bf = item.breakfast || {};
          var ln = item.lunch || {};
          var dn = item.dinner || {};

          var row = [
            '"' + (item.date || '') + '"',
            '"' + (bf.sugar || '') + '"',
            '"' + (bf.insulin || '') + '"',
            '"' + (bf.nashta ? bf.nashta.replace(/"/g, '""') : '') + '"',
            '"' + (bf.sugar2h || '') + '"',
            '"' + (bf.elevenAm ? bf.elevenAm.replace(/"/g, '""') : '') + '"',
            '"' + (ln.sugar || '') + '"',
            '"' + (ln.insulin || '') + '"',
            '"' + (ln.meal ? ln.meal.replace(/"/g, '""') : '') + '"',
            '"' + (ln.sugar2h || '') + '"',
            '"' + (ln.fivePm ? ln.fivePm.replace(/"/g, '""') : '') + '"',
            '"' + (dn.sugar || '') + '"',
            '"' + (dn.insulin || '') + '"',
            '"' + (dn.meal ? dn.meal.replace(/"/g, '""') : '') + '"',
            '"' + (dn.sugar2h || '') + '"',
            '"' + (dn.tresiba || '') + '"',
            '"' + (dn.milk || '') + '"',
            '"' + (item.remarks ? item.remarks.replace(/"/g, '""') : '') + '"'
          ];
          rows.push(row.join(","));
        }

        var csvContent = "\uFEFF" + rows.join("\r\n"); // UTF-8 BOM for Hindi text in Excel
        var blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
        var link = document.createElement("a");
        var url = URL.createObjectURL(blob);
        link.setAttribute("href", url);
        link.setAttribute("download", "Type1_Diabetes_Sugar_Diary_" + getTodayString() + ".csv");
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        showToast('📁 CSV फाइल डाउनलोड हो गई!');
      }

